clc; clear;close all;

%% Generate microstructural connectivity table 

global RUC_w RUC_t RUC_l shtlt_w shtlt_t Mesoscale ModelName shtlt_shrink_ratios

ModelName = 'Micro_test_ORI';

% Define whether generating microscale RUC or Mesoscale RUC
Mesoscale = 1;

% Define the size of Representative Unit Cell (RUC)
RUC_w = 200;  
RUC_t = 80;
RUC_l = 500;

% Sheetlet width and thickness
shtlt_w = 200;
shtlt_t = 45;

% Shrink ratio for sheetlets in sheetlet and normal directions
% Ratio[1] = shrink ratio for cleavage planes normal to sheetlet direction
% Ratio[2] = shrink ratio for cleavage planes parallel to sheetlet direction
% Each ratio value range  - (0.3, 1)

shtlt_shrink_ratios = [0.955, 0.825]; 

% Cardiomyocyte dimensions
innitial_myocyte_diameter = 10;
myocyte_length_range = [100, 120]; % [minimum myocyte length, maximum myocyte length]
max_fibredir_deviation = innitial_myocyte_diameter / 6; % maximum deviation in sheetlet-normal plane per cardiomyocyte length


% Sheetlet innitial volume fraction
shtlt_ICV = 0.95;


% Technical values
randomization_breakpoint = 500000;


ruc_con = RUC_microstructure_Toolbox.generate_ruc_myoconnectivity(RUC_w, RUC_t, RUC_l, shtlt_w, shtlt_t, ...
    shtlt_shrink_ratios, innitial_myocyte_diameter, myocyte_length_range, shtlt_ICV, ...
    max_fibredir_deviation, randomization_breakpoint);

%a_gen_contable

%% Generate mask for diff simulation and volume fraction calculation

% clear;
% clc;

ModelName = 'Meso_paper_figs';

%Load required parameters from saved workspace
workspace_address = append(ModelName,'_conData.mat');

load(workspace_address,'Final_branches');
load(workspace_address,'non_shrink_vor_ruc');
load(workspace_address,'RUC_con_table_branched');
load(workspace_address,'RUC_con_table_sheetlet_wise');
load(workspace_address,'RUC_con_v1_branched');
load(workspace_address,'RUC_con_v2_branched');
load(workspace_address,'RUC_v_coord');
load(workspace_address,'Shrinked_after_inf');
load(workspace_address,'Shrinked_after_inf_mid');
load(workspace_address,'RUC_w','RUC_t','RUC_l');

% translate cells to origin and generate required datasets
% d_preprocess_condata
%% Pre-process to translate all coordinates to origin and find dimensions

%% Rotate vor cells
% Shrinked_after_inf = Coordinate_Toolbox.Rotate_2D_poly(Shrinked_after_inf,pi/4); %note thta translations were not done to the polygon coordinates
% Shrinked_after_inf_mid = Coordinate_Toolbox.Rotate_2D_poly(Shrinked_after_inf_mid,pi/4);


%% Translate
min_point =[0,0,0];
%find coordinate range
[coord_details] = Coordinate_Toolbox.Modification_amount_and_dimension(Shrinked_after_inf,RUC_v_coord,min_point);
modify_amount = coord_details(1,:);
RUC_dim = ceil(coord_details(2,:));
% aa = modify_amount(2);
% bb = modify_amount(3);
% Shrinked_after_inf_mid{end+1} = [450-aa,0-bb;0-aa,450-bb;0-aa,0-bb];
% Shrinked_after_inf_mid{end+1} = [0-aa,500-bb;485-aa,980-bb;0-aa,980-bb];
% Shrinked_after_inf_mid{end+1} = [520-aa,0-bb;980-aa,0-bb;980-aa,450-bb];
% Shrinked_after_inf_mid{end+1} = [980-aa,520-bb;980-aa,980-bb;520-aa,980-bb];

%Calculate translated vertex coordinates pointwice cell and double of
%coordinates
Modified_point_list = Coordinate_Toolbox.Modify_RUC_coord_mask(RUC_v_coord,modify_amount); %type- cell
Modified_coordinates = Coordinate_Toolbox.cell_to_double_coordinates(Modified_point_list); %type- double


%Obtain translated sheetlet coordinates and shrinked sheetlets

%Sheetlet regions - use to generate sheetletwise mask
Modified_sheetlet_regions = Coordinate_Toolbox.Modify_shtlt_coord(Shrinked_after_inf,modify_amount);
%Shrinked sheetlets - use to identify cleavage reagons to generate mask for
%inter-sheetlet branches
Modified_mid_sheetlets = Coordinate_Toolbox.Modify_shtlt_coord(Shrinked_after_inf_mid,modify_amount);

%%

%Plot translated cell network
figure(3)
hold on
con_graph_ruc_branched=graph(RUC_con_v1_branched,RUC_con_v2_branched);
pp_ruc_branched=plot(con_graph_ruc_branched);
pp_ruc_branched.XData=Modified_coordinates(:,1);
pp_ruc_branched.YData=Modified_coordinates(:,2);
pp_ruc_branched.ZData=Modified_coordinates(:,3); 
axis equal

%% Generte required cell lists

all_cell_list = Mask_generate_Toolbox.gen_cell_detail_list(RUC_con_table_branched,Modified_point_list,12);

shtlt_wise_cell_list = Mask_generate_Toolbox.Sheetletwise_cell_details(RUC_con_table_sheetlet_wise,Modified_point_list,12);

inter_shtlt_branch_list = Mask_generate_Toolbox.gen_cell_detail_list(Final_branches,Modified_point_list,12);

save(append(ModelName,'_mechInput.mat'),"RUC_w","RUC_l","RUC_t","Modified_coordinates","Modified_sheetlet_regions","RUC_con_table_sheetlet_wise")

%%
% Generate mask
%e_generate_mask